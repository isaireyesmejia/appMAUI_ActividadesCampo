<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:agaverosActividades.Converters"
             xmlns:controls="clr-namespace:agaverosActividades.Controls"
             x:Class="agaverosActividades.Views.Bienvenido"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:TabSelectedColorConverter x:Key="TabSelectedColorConverter"/>
            <conv:TabSelectedTextColorConverter x:Key="TabSelectedTextColorConverter"/>
            <conv:IntMayorQueCeroConverter x:Key="IntMayorQueCeroConverter"/>
            <conv:IntEsCeroConverter x:Key="IntEsCeroConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Spacing="0">

                <!-- ================= HEADER UNIFICADO ================= -->
                <!-- Pantalla raíz: sin título ni botón atrás (MostrarFranjaTitulo="False"),
                     usa el ícono de identidad para Cerrar Sesión en su lugar. -->
                <controls:AppHeaderView MostrarFranjaTitulo="False"
                         MostrarIconoIdentidad="True"
                         IconoIdentidad="&#128682;"
                         ComandoIdentidad="{Binding CerrarSesionCommand}" />

                <!-- ================= TABS: Operación / Sincronizar ================= -->
                <!-- ================= TABS: Operación / Sincronizar ================= -->
                <Grid ColumnDefinitions="*,*"
      Margin="16,18,16,0"
      HeightRequest="46">

                    <!-- Tab Operación: columna 0 -->
                    <Border Grid.Column="0"
            StrokeShape="RoundRectangle 12,0,0,12"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
            StrokeThickness="1"
            BackgroundColor="{Binding IsTabOperacionSelected, Converter={StaticResource TabSelectedColorConverter}}">
                        <Label Text="Operación"
               HorizontalOptions="Center" VerticalOptions="Center"
               FontAttributes="Bold" FontSize="14"
               TextColor="{Binding IsTabOperacionSelected, Converter={StaticResource TabSelectedTextColorConverter}}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarOperacionCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Tab Sincronizar: columna 1, con badge de pendientes -->
                    <Border Grid.Column="1"
            StrokeShape="RoundRectangle 0,12,12,0"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
            StrokeThickness="1"
            BackgroundColor="{Binding IsTabSincronizarSelected, Converter={StaticResource TabSelectedColorConverter}}">
                        <Grid>
                            <Label Text="Sincronizar"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   FontAttributes="Bold" FontSize="14"
                   TextColor="{Binding IsTabSincronizarSelected, Converter={StaticResource TabSelectedTextColorConverter}}" />

                            <Border IsVisible="{Binding TotalPendientes, Converter={StaticResource IntMayorQueCeroConverter}}"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="#E74C3C"
                    Padding="6,2"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-6,4,0">
                                <Label Text="{Binding TotalPendientes}"
                       TextColor="White"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarSincronizarCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>

                <!-- ================= CONTENIDO TAB: OPERACIÓN ================= -->
                <StackLayout IsVisible="{Binding IsTabOperacionSelected}"
                             Padding="16,10,16,0" Spacing="10">

                    <!-- Actividades -->
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Actividades"
                                   FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Label Grid.Column="1" Text="›" FontSize="20"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#9E3700, Dark=#FF9E63}"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpcionActividadesCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Autorización Superior -->
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Autorización Superior"
                                   FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Label Grid.Column="1" Text="›" FontSize="20"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#9E3700, Dark=#FF9E63}"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpcionAutorizacionSuperiorCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Act. Prep. Terreno -->
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Act. Prep. Terreno"
                                   FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Label Grid.Column="1" Text="›" FontSize="20"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#9E3700, Dark=#FF9E63}"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpcionActPrepTerrenoCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </StackLayout>

                <!-- ================= CONTENIDO TAB: SINCRONIZAR ================= -->
                <StackLayout IsVisible="{Binding IsTabSincronizarSelected}"
             Padding="16,20,16,0" Spacing="14" HorizontalOptions="Center">

                    <Label Text="{Binding TotalPendientes, StringFormat='{0} registro(s) pendiente(s) de sincronizar'}"
           IsVisible="{Binding TotalPendientes, Converter={StaticResource IntMayorQueCeroConverter}}"
           HorizontalOptions="Center" FontSize="15" FontAttributes="Bold"
           TextColor="{AppThemeBinding Light=#9E3700, Dark=#FF9E63}"/>
                    <Label Text="{Binding ErroresPendientes, StringFormat='{0} con error — revísalos antes de reintentar'}"
           IsVisible="{Binding ErroresPendientes, Converter={StaticResource IntMayorQueCeroConverter}}"
           HorizontalOptions="Center" FontSize="13" FontAttributes="Bold"
           TextColor="#E74C3C"/>
                    <Label Text="No hay registros pendientes. Todo está sincronizado."
           IsVisible="{Binding TotalPendientes, Converter={StaticResource IntEsCeroConverter}}"
           HorizontalOptions="Center" FontSize="14"
           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                    <Label Text="{Binding ProgresoTexto}" HorizontalOptions="Center" FontSize="16"
           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Image HorizontalOptions="Center"
                           WidthRequest="50" Source="cargando.gif"
                           IsAnimationPlaying="{Binding EstaSincronizando}"
                           IsVisible="{Binding EstaSincronizando}"/>

                    <Button Text="Sincronizar ahora"
                            TextColor="White"
                            FontAttributes="Bold"
                            BackgroundColor="#22DECA"
                            CornerRadius="12"
                            HorizontalOptions="Fill"
                            Command="{Binding SincronizarCommand}"/>
                </StackLayout>

                <!-- ================= LOGO DE BIENVENIDA ================= -->
                <Border HorizontalOptions="Center"
        Margin="0,28,0,24"
        StrokeShape="RoundRectangle 14"
        Stroke="Transparent"
        BackgroundColor="Transparent"
        Padding="10">
                    <Image MaximumWidthRequest="260"
           Aspect="AspectFit"
           Source="logo.png"/>
                </Border>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>