<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:agaverosActividades.ViewModels"
             x:Class="agaverosActividades.Views.ExplosionRecetaPage"
             x:DataType="vm:ExplosionRecetaViewModel"
             Title="Materia prima"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="{Binding DescripcionInsumo}" FontSize="16" FontAttributes="Bold" TextColor="#9E3700" />
            <Label Text="Ajusta la cantidad aplicada de cada materia prima si es necesario."
                   FontSize="12" TextColor="Gray" />

            <CollectionView ItemsSource="{Binding MateriasPrimas}" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MateriaPrimaAgregadaItem">
                        <Border StrokeShape="RoundRectangle 10" Stroke="#DDDDDD" Padding="10" Margin="0,4">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Descripcion}" FontAttributes="Bold" FontSize="14" />
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Calculado" FontSize="11" TextColor="Gray" />
                                        <Label Text="{Binding CantidadOriginal}" FontSize="13" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Aplicado" FontSize="11" TextColor="Gray" />
                                        <Entry Text="{Binding Cantidad}" Keyboard="Numeric" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Unidad}" VerticalOptions="End"
                                           FontSize="13" Margin="0,0,0,6" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Listo" Command="{Binding CerrarCommand}"
                    BackgroundColor="#9E3700" TextColor="White" CornerRadius="8" Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>