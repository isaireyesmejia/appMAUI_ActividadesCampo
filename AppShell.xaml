<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="agaverosActividades.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:agaverosActividades"
    xmlns:views="clr-namespace:agaverosActividades.Views"
    Title="agaverosActividades">

    <!-- Página de Login como página inicial (sin navbar) -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:Login}"
        Route="login" />

    <!-- Página de Bienvenido tras iniciar sesión -->
    <ShellContent
        Title="Bienvenido"
        ContentTemplate="{DataTemplate views:Bienvenido}"
        Route="bienvenido" />

</Shell>